{
  "dataset_name": "ablation_bundles",
  "version": "2026-05-05",
  "base_bundle_file": "profile_input_bundles.json",
  "required_variants": [
    "full",
    "no_dialogue_text",
    "no_answer_records",
    "no_resource_usage",
    "no_learning_records",
    "id_only"
  ],
  "variant_templates": [
    {
      "variant": "full",
      "drop_fields": [],
      "purpose": "全量输入作为基线"
    },
    {
      "variant": "no_dialogue_text",
      "drop_fields": ["dialogue_text", "learning_goal"],
      "purpose": "验证缺少主观文本时，是否仍能依赖行为和答题信号"
    },
    {
      "variant": "no_answer_records",
      "drop_fields": ["answer_records"],
      "purpose": "验证没有答题数据时，知识掌握度与风险判断如何退化"
    },
    {
      "variant": "no_resource_usage",
      "drop_fields": ["resource_usage"],
      "purpose": "验证资源偏好和学习风格特征是否明显受损"
    },
    {
      "variant": "no_learning_records",
      "drop_fields": ["learning_records"],
      "purpose": "验证活跃度、时长与注意力模式是否明显受损"
    },
    {
      "variant": "id_only",
      "drop_fields": ["dialogue_text", "learning_goal", "learning_records", "answer_records", "resource_usage"],
      "purpose": "验证只保留 user_id + syllabus_id 时的最低可用输出"
    }
  ],
